# Example schedule for the related Meshtastic jobs described in README.md.
# Jobs that use flock must use the same lock path as Space Weather:
# /tmp/meshtastic-node.lock
# SWPC Space Weather: minutes 5, 10, ..., 55; skips :00 to avoid hourly weather
# Locks internally; do not add an outer flock.
5-55/5 * * * * cd /scripts/spaceweather && /usr/bin/timeout 240 /usr/bin/python3 /scripts/spaceweather/spaceweather_alerts.py >> /scripts/logs/spaceweather_alerts.log 2>&1

