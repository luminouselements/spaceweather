# Meshtastic TCP node
MESHTASTIC_NODE_IP=192.168.0.1

# Channel indexes already configured on the node.
# Set one or more comma-separated indexes. MESHTASTIC_CHANNEL is used only
# when MESHTASTIC_CHANNELS is not set.
MESHTASTIC_CHANNELS=2
# MESHTASTIC_CHANNEL=2

# Maximum outgoing message size; values above 200 are capped at 200.
MAX_MESSAGE_LENGTH=200

# Delay after connecting to the node and between channel sends (seconds).
INTERFACE_STABILIZATION_DELAY=3
RADIO_BUFFER_CLEAR_DELAY=6

# SWPC feed retry settings.
SWPC_RETRIES=5
SWPC_RETRY_DELAY=2

# On first run (when CACHE_FILE does not exist), only send products issued
# within this many hours. Older products are recorded without being sent.
SWPC_INITIAL_LOOKBACK_HOURS=2

# Number of product IDs retained for deduplication.
MAX_CACHE_ENTRIES=500

# Optional paths. Defaults are under ./logs relative to the script directory.
# For scheduled jobs, use absolute paths if the working directory can vary.
# CACHE_FILE=
# LOG_FILE=

# Optional shared Meshtastic mutex path. Defaults to the system temp directory
# on Windows and /tmp/meshtastic-node.lock on POSIX. Set this to the exact same
# path used by your other senders; locks only coordinate when both path and
# locking mechanism are shared.
# GLOBAL_MUTEX_LOCK=
